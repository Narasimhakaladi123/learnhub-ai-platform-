#!/bin/sh
PRG="$0"
while [ -h "$PRG" ]; do
  ls=`ls -ld "$PRG"`
  link=`expr "$ls" : '.*-> \(.*\)$'`
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=`dirname "$PRG"`/"$link"
  fi
done
SAVED="`pwd`"
DIR="`dirname "$PRG"`"
cd "$DIR"
DIR="`pwd`"
cd "$SAVED"

if [ -f "$DIR/../.tools/apache-maven-3.9.6/bin/mvn" ]; then
  exec "$DIR/../.tools/apache-maven-3.9.6/bin/mvn" "$@"
else
  exec mvn "$@"
fi
